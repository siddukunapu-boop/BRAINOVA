{
  "build": {
    "env": {
      "UV_LINK_MODE": "copy"
    }
  },
  "functions": {
    "api/*.py": {
      "includeFiles": "backend/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron/tech-pulse",
      "schedule": "0 1 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
