# AetherLearn AI — Environment Configuration Template
# Copy this file to .env to customize local settings.
# Never commit actual secret keys to version control.

# Server & Security
PORT=8000
# Local development creates and reuses data/.aether_jwt_secret when this is blank.
# Set a unique value of at least 32 characters in production.
AETHER_ENV=development
AETHER_JWT_SECRET=
# Dedicated AES-256-GCM master key for encrypting API credentials at rest in SQLite.
# Must be distinct from AETHER_JWT_SECRET. Supports key rotation (e.g. k2:<new_key>,k1:<old_key>).
# Local development creates and reuses data/.aether_master_key when blank.
BRAINOVA_MASTER_KEY=
AETHER_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173
# Optional persistent data root (defaults to <BASE_DIR>/data; set to /var/data on Render)
BRAINOVA_DATA_DIR=
AETHER_DB_PATH=data/aetherlearn.db

# Optional External AI Provider Credentials
# When configured, live LLM calls are executed from the server.
# You can also configure these safely per-user in the Settings page.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Optional External Media & Search Credentials
YOUTUBE_DATA_API_KEY=
ELEVENLABS_API_KEY=
VIDEO_PROVIDER_API_KEY=

# Email OTP Verification (Required for New User Registration)
# Dedicated HMAC secret for OTP hashing (auto-generated in data/.aether_otp_secret if blank)
BRAINOVA_OTP_SECRET=

# Email Transport Provider: "smtp" (Gmail/Generic SMTP) or "resend" (Production Transactional API)
EMAIL_PROVIDER=smtp

# SMTP Delivery Settings (Gmail SMTP Example: smtp.gmail.com, port 587, STARTTLS enabled)
# For Gmail, use a 16-character Google App Password (not your regular Gmail password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=BRAINOVA
SMTP_USE_TLS=true

# Production Transactional Email Provider (Resend) & Webhook Settings
EMAIL_API_KEY=
EMAIL_WEBHOOK_SECRET=
EMAIL_SENDER_DOMAIN=

