# AetherLearn AI — Environment Configuration Template
# Copy this file to .env to customize local settings.
# Never commit actual secret keys to version control.

# Server & Security
PORT=8000
# Local development creates and reuses data/.aether_jwt_secret when this is blank.
# Set a unique value of at least 32 characters in production.
AETHER_ENV=development
AETHER_JWT_SECRET=
AETHER_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173
AETHER_DB_PATH=data/aetherlearn.db

# Optional External AI Provider Credentials
# When configured, live LLM calls are executed from the server.
# You can also configure these safely per-user in the Settings page.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Optional External Media & Search Credentials
YOUTUBE_DATA_API_KEY=
ELEVENLABS_API_KEY=
VIDEO_PROVIDER_API_KEY=

